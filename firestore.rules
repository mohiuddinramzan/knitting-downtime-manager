// Firestore Security Rules — Knitting Machine Downtime Manager
//
// This matches the REAL login model the app now uses: every
// Operator/Technician/Supervisor/Admin has their own Firebase Auth
// account (email + password), created only by an Admin (from the
// in-app Admin Panel, or manually the very first time - see README
// Section 6). There is no anonymous/guest access anymore - nobody can
// open the app and do anything without an account someone gave them.
//
// Each user's role/name/shift lives in Firestore at /users/{uid}, where
// {uid} is their Firebase Auth UID. Passwords are never stored in
// Firestore - Firebase Authentication handles those securely.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste this -> Publish

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn() && myProfile().active == true;
    }

    function myRole() {
      return isActive() ? myProfile().role : null;
    }

    function isAdmin() { return myRole() == 'ADMIN'; }
    function isSupervisorOrAdmin() { return myRole() == 'SUPERVISOR' || myRole() == 'ADMIN'; }

    function isAssignedTo(machineId) {
      let a = get(/databases/$(database)/documents/meta/assignments).data;
      return myRole() == 'OPERATOR' &&
        a.get(myProfile().shift, {}).get(machineId, '') == request.auth.uid;
    }

    // ---------- users (profiles only - no passwords live here) ----------
    match /users/{userId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- machines ----------
    match /machines/{machineId} {
      allow read: if isActive();
      allow write: if isActive() && (
        isSupervisorOrAdmin() || myRole() == 'TECHNICIAN' || isAssignedTo(machineId)
      );
    }

    // ---------- meta/assignments, meta/categories, meta/settings ----------
    match /meta/assignments {
      allow read: if isActive();
      allow write: if isSupervisorOrAdmin();
    }
    match /meta/categories {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    match /meta/settings {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------- downtimeRecords ----------
    match /downtimeRecords/{recordId} {
      allow read: if isActive();
      allow create: if isActive() && (
        isSupervisorOrAdmin() || myRole() == 'TECHNICIAN' || isAssignedTo(request.resource.data.machineId)
      );
      allow update: if isActive() && (
        isSupervisorOrAdmin() || myRole() == 'TECHNICIAN' || isAssignedTo(resource.data.machineId)
      );
      // Corrections are modeled as status: 'cancelled', never a delete.
      allow delete: if false;
    }

    // ---------- auditLogs: append-only for everyone, no exceptions ----------
    match /auditLogs/{logId} {
      allow read: if isSupervisorOrAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}
