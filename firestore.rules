// Firestore Security Rules — Knitting Machine Downtime Manager
//
// How auth actually works in this app: every device signs in
// *anonymously* (see src/js/sync.js) just so Firestore can tell "this is
// a request from someone who loaded our app" apart from a random stranger
// on the internet. The app's own ID+PIN login (Operator/Technician/
// Supervisor/Admin) is a separate, app-level check enforced in
// src/js/db.js on every device.
//
// WHAT THIS PROTECTS AGAINST: random internet traffic hitting your
// Firestore database directly (nobody can read/write without first
// loading the app and getting an anonymous session).
//
// WHAT THIS DOES NOT PROTECT AGAINST: a person who has the app installed
// deciding to open browser devtools and call the Firestore SDK directly
// to bypass the role checks in db.js. Closing that gap requires giving
// each operator/technician/supervisor/admin a *real* Firebase Auth
// account (not just anonymous) and rewriting these rules to check
// request.auth.uid against a role stored server-side — which needs a
// backend (e.g. a Cloud Function) to issue those accounts safely. That's
// a reasonable next step for a larger rollout, but out of scope for the
// free, no-code-backend setup this project ships with.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste this -> Publish
// (or: firebase deploy --only firestore:rules, if you use the CLI)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /machines/{machineId} {
      allow read, write: if signedIn();
    }

    match /meta/{docId} {
      // assignments, categories, settings
      allow read, write: if signedIn();
    }

    match /downtimeRecords/{recordId} {
      allow read, write: if signedIn();
    }

    // Audit log: any signed-in device can add an entry, but nothing can
    // ever edit or delete one - enforced here at the database level, not
    // just by db.js not exposing a delete function.
    match /auditLogs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
  }
}
